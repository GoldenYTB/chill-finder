{
  "expo": {
    "name": "Chill Finder",
    "slug": "chill-finder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#180f28",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "com.chillfinder.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.chillfinder.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#180f28"
      }
    }
  }
}
